@echo off
:: 設定編碼為 UTF-8 以顯示中文
chcp 65001 > nul
setlocal

:: 切換到 bat 檔所在的目錄
cd /d "%~dp0"

echo ========================================================
echo   開始執行全自動化更新流程
echo   Time: %date% %time%
echo ========================================================

:: ----------------------------------------------------------
:: STEP 1: 更新三大法人數據 (Institutional Data)
:: ----------------------------------------------------------
echo.
echo [1/3] 更新三大法人數據 (update_all.py)...
echo --------------------------------------------------------
python update_all.py
if %errorlevel% neq 0 (
    echo [ERROR] update_all.py 執行失敗，請檢查錯誤訊息。
    pause
    exit /b %errorlevel%
)

:: ----------------------------------------------------------
:: STEP 2: 更新券商分點數據 (Broker Data)
:: ----------------------------------------------------------
echo.
echo [2/3] 更新券商分點數據 (update_broker.py)...
echo --------------------------------------------------------
:: 這裡使用預設模式 (自動抓取熱門股 + 讀取今日已抓過的紀錄)
python update_broker.py
if %errorlevel% neq 0 (
    echo [ERROR] update_broker.py 執行失敗，請檢查錯誤訊息。
    pause
    exit /b %errorlevel%
)

:: ----------------------------------------------------------
:: STEP 3: 啟動網頁伺服器並開啟瀏覽器
:: ----------------------------------------------------------
echo.
echo [3/3] 啟動本地網頁伺服器...
echo --------------------------------------------------------

:: 檢查 docs 資料夾是否存在 (因為網頁在 docs 裡面)
if exist "docs" (
    :: 切換到 docs 資料夾，這樣網址只要打 localhost:8000 就會直接看到 index.html
    cd docs
) else (
    echo [WARN] 找不到 docs 資料夾，將在根目錄啟動伺服器。
)

:: 在新視窗啟動 Python Server (避免卡住目前的視窗)
:: 使用 start /min 讓它最小化啟動，不干擾視線
start /min "Stock Web Server" python -m http.server 8000

:: 等待 2 秒讓伺服器準備好
timeout /t 2 > nul

:: 開啟預設瀏覽器
echo 正在開啟瀏覽器...
start http://localhost:8000

echo.
echo ========================================================
echo   所有流程執行完畢！
echo   請查看瀏覽器視窗。
echo ========================================================
:: 倒數 5 秒後自動關閉這個黑色視窗
timeout /t 5